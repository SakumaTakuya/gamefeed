{
  "name": "@gamefeed/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "dev": "tsx watch src/dev.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.16",
    "@better-auth/mcp": "1.7.16",
    "@gamefeed/domain": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "better-auth": "1.7.16",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.20.5",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
