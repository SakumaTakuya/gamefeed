# apps/api（Vercel の環境変数に入れる。ローカルは apps/api/.env）
DATABASE_URL=postgresql://user:pass@host:6543/postgres
BETTER_AUTH_SECRET=change-me-32-chars-minimum
# 外から見える URL（末尾スラッシュなし）。OAuth の issuer は ${BETTER_AUTH_URL}/api/auth、MCP の resource は ${BETTER_AUTH_URL}/api/mcp
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# apps/games（wrangler secret で入れる）
# なし（R2 バインディングは wrangler.toml）
