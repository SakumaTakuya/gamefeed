# apps/api（Vercel の環境変数に入れる。ローカルは apps/api/.env）
DATABASE_URL=postgresql://user:pass@host:6543/postgres
BETTER_AUTH_SECRET=change-me-32-chars-minimum
# 外から見える URL（末尾スラッシュなし）。OAuth の issuer は ${BETTER_AUTH_URL}/api/auth、MCP の resource は ${BETTER_AUTH_URL}/api/mcp
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# publish_game の保存先（mc#A.8）。無ければ publish_game は not_configured を返す（他は動く）
# R2: Cloudflare ダッシュボード → R2 → API トークン（Object Read & Write、バケット gamefeed-games 限定）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=gamefeed-games
# KV serve:<post_id>（se#A.5）。API トークンは Workers KV Storage の Edit だけ（se#A.8）
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
KV_NAMESPACE_ID=
# 下書きの試遊トークンの署名鍵（se#A.5）。32 文字以上の乱数（例: openssl rand -base64 32）。
# 配信 Worker（apps/games）にも同じ値を `wrangler secret put GAMES_SIGNING_SECRET` で入れる。無ければ play-token は not_configured
GAMES_SIGNING_SECRET=
# apps/web（Vercel のビルド時に読む。Vite が VITE_ で始まる変数だけをクライアントに埋め込む）
# 配信オリジン（配信 Worker の URL、末尾スラッシュなし。se#A.1）。無ければ試遊ページはゲームを読み込めない
VITE_GAMES_ORIGIN=https://gamefeed-games.<account>.workers.dev
# apps/games（wrangler secret で入れる）
# GAMES_SIGNING_SECRET（上と同じ値）。R2 / KV のバインディングと APP_ORIGIN は wrangler.toml
